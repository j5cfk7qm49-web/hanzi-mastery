{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react",
    "strict": true, "esModuleInterop": true, "resolveJsonModule": true,
    "skipLibCheck": true, "noEmit": true, "types": ["node", "vitest/globals"]
  },
  "include": ["src", "tests", "e2e", "*.config.ts"]
}
